# Copy to .env.local for local development (values printed by `npx supabase start`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-publishable-or-anon-key
# Where the /api/v1 function is served. Defaults to {VITE_SUPABASE_URL}/functions/v1/api/v1
# VITE_API_URL=http://127.0.0.1:54321/functions/v1/api/v1
# Shown on the sign-in screen and in backups.
VITE_APP_ENV=local
